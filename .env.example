# ============================================================================
# Supabase
# Get these from your Supabase project: Settings -> API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the client. Used by AI
# pipelines (resume parsing, scoring, matching) to write across RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# AI provider (OpenRouter -- an OpenAI-API-compatible gateway)
# https://openrouter.ai/keys
# OPENAI_API_KEY holds an OpenRouter key ("sk-or-v1-..."), not an OpenAI key
# -- the shared client (src/lib/ai/openai.ts) points the official `openai`
# SDK at OpenRouter's endpoint instead of OpenAI's own. AI_BASE_URL and the
# AI_MODEL_* vars are optional; each has a working default below, so only
# set them if you need to point at a different endpoint/model.
# ============================================================================
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_REASONING=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=openai/text-embedding-3-small

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
