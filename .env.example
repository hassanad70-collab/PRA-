# ============================================================================
# Supabase
# Get these from your Supabase project: Settings -> API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the client. Used by AI
# pipelines (resume parsing, scoring, matching) to write across RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# AI provider (OpenRouter -- an OpenAI-API-compatible gateway)
# https://openrouter.ai/keys
# OPENAI_API_KEY holds an OpenRouter key ("sk-or-v1-..."), not an OpenAI key
# -- the shared client (src/lib/ai/openai.ts) points the official `openai`
# SDK at OpenRouter's endpoint instead of OpenAI's own. AI_BASE_URL and the
# AI_MODEL_* vars are optional; each has a working default below, so only
# set them if you need to point at a different endpoint/model.
# ============================================================================
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_REASONING=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=openai/text-embedding-3-small

# ============================================================================
# Email (Resend)
# https://resend.com/api-keys
# Without this key, emails are stubbed in development and preview, but the
# app will throw in production if RESEND_API_KEY is absent.
# ============================================================================
RESEND_API_KEY=re_your-resend-key

# ============================================================================
# Stripe
# https://dashboard.stripe.com/apikeys
# Webhook secret: Dashboard -> Webhooks -> your endpoint -> Signing secret
# Price IDs: Dashboard -> Products -> your plan -> copy the price ID
# ============================================================================
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_STARTER=price_your-starter-price-id
STRIPE_PRICE_ID_PROFESSIONAL=price_your-professional-price-id
STRIPE_PRICE_ID_ENTERPRISE=price_your-enterprise-price-id

# ============================================================================
# Cron
# A secret token Vercel injects automatically when it calls your cron routes
# (Vercel Pro+). Set the same value in: Vercel -> Settings -> Environment
# Variables AND in vercel.json cron headers (or rely on Vercel's automatic
# injection for Vercel Cron). The endpoint refuses unauthenticated calls on
# any hosted environment (production or preview) if this is set.
# ============================================================================
CRON_SECRET=your-random-cron-secret

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
